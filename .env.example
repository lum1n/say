SAY_ENV=development
SAY_ADDR=:8080
SAY_DATABASE_URL=postgres://say:say@localhost:54329/say?sslmode=disable

# Generate independent random values of at least 32 bytes for deployment.
SAY_JWT_SIGNING_KEY=development-jwt-key-change-me-000000000
SAY_LOGIN_HASH_KEY=development-login-key-change-me-000000
SAY_JWT_ISSUER=say
SAY_MESSAGE_RETENTION_DAYS=30
SAY_MESSAGE_KEEP_PER_CONVERSATION=500

# Development only. Returns the login code from POST /v1/auth/start.
SAY_AUTH_DEBUG_RETURN_CODE=true

# Development/test escape hatch. Never enable in production.
SAY_DEV_AUTH=false

# Production magic-code delivery via email-service.
# SAY_AUTH_WEBHOOK_URL=https://email.example/emails/send
# SAY_AUTH_WEBHOOK_TOKEN=
# SAY_AUTH_EMAIL_FROM="Say <noreply@example.com>"

# Generated automatically by `make deploy` when .env.production is absent.
POSTGRES_PASSWORD=replace-with-random-hex
SAY_JWT_SIGNING_KEY=replace-with-independent-random-hex
SAY_LOGIN_HASH_KEY=replace-with-independent-random-hex

SAY_PUBLIC_PORT=8000
SAY_WORKER_BASE_URL=wss://your-vm.exe.xyz
SAY_JWT_ISSUER=say
SAY_MESSAGE_RETENTION_DAYS=30
SAY_MESSAGE_KEEP_PER_CONVERSATION=500

# Required for usable production login. Points at email-service POST /emails/send.
SAY_AUTH_WEBHOOK_URL=https://email.example/emails/send
SAY_AUTH_WEBHOOK_TOKEN=
SAY_AUTH_EMAIL_FROM="Say <noreply@example.com>"

# Leave empty for the initial control-plane deployment. After creating provider
# accounts, set this to signal, telegram, or signal,telegram and rerun
# `make deploy`.
COMPOSE_PROFILES=
SAY_SIGNAL_ENROLLMENT_TOKEN=
SAY_TELEGRAM_ENROLLMENT_TOKEN=
SIGNAL_LINK_NAME=say

# Required only by the Telegram profile.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_DB_ENCRYPTION_KEY=
